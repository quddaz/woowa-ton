# Cloudtype TCP proxy -> MariaDB
# svc.sel3.cloudtype.app:32433 TCP -> mariadb:3306

MARIADB_HOST=svc.sel3.cloudtype.app
MARIADB_PORT=32433
MARIADB_DATABASE=app
MARIADB_USER=root
MARIADB_PASSWORD=change_me

# Optional single-url form
DATABASE_URL=mysql://root:change_me@svc.sel3.cloudtype.app:32433/app
